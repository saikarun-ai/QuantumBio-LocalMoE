LOCALMOE_LOG_LEVEL=INFO
MODEL_DIRECTORY=./models
# Comma-separated extra directories scanned for GGUF models (e.g. a shared LLMS folder)
MODEL_EXTRA_DIRECTORIES=D:/Gen AI Applications/LLMS
# LLMS_MODEL_PATH is bind-mounted into the engine container so Docker deploys use the same weights
LLMS_MODEL_PATH=D:/Gen AI Applications/LLMS
# Leave empty to auto-pick the largest text model; or pin one by filename
MODEL_NAME=DeepSeek-R1-Distill-Qwen-1.5B-Q6_K_L.gguf
# Leave empty to auto-pick the smallest text model as speculative draft
DRAFT_MODEL_PATH=
QUANTIZATION_TYPE=AWQ
DATABASE_URL=postgresql+asyncpg://postgres:secret@localhost:5432/localmoe
QDRANT_HOST=localhost
QDRANT_PORT=6333
REDIS_HOST=localhost
REDIS_PORT=6379
HOST=0.0.0.0
PORT=8000